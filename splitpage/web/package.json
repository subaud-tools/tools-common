{
  "name": "splitpage",
  "private": true,
  "version": "0.0.0",
  "description": "tools-common's split page. DEV-TIME ONLY: the built output lives in splitpage/assets and is committed; `npm run build` rebuilds it. Nothing at runtime needs node.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test *.test.ts",
    "build:js": "esbuild entry.ts --bundle --format=esm --charset=utf8 --outfile=../assets/split.js",
    "build:css": "esbuild split.css --bundle --charset=utf8 --outfile=../assets/split.css",
    "build": "npm run --silent build:js && npm run --silent build:css"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
